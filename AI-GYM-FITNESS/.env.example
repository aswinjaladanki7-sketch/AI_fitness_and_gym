# AI GYM & FITNESS ASSISTANT - Environment Variables
# College Project: SRM INSTITUTE OF SCIENCE AND TECHNOLOGY

# Application Configuration
APP_NAME="AI Gym & Fitness Assistant"
APP_ENV="development"
PORT=5000
DEBUG=True
SECRET_KEY="ai-gym-fitness-secret-key-srmist-21csc203p"
JWT_SECRET="ai-gym-jwt-super-secret-key-2026"

# Database Configuration (MySQL)
# Default MySQL local port is 3306
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD=""
DB_NAME="ai_gym_fitness"

# Fallback Configuration
# If MySQL server is unreachable, system automatically connects to SQLite
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH="ai_gym_fitness.db"

# AI Computer Vision
CV_CONFIDENCE_THRESHOLD=0.5
CV_TRACKING_CONFIDENCE=0.5
